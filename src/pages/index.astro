---
// src/pages/index.astro
export const prerender = true;
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/sections/Hero';
import Services from '@/components/sections/Services.astro';//revisar luego
import { TestimonialsSlider } from '@/components/sections/TestimonialsSlider';
import { supabase } from '@/lib/supabase';
import { getGlobalSettings } from '@/lib/data'; // ✅ Importamos el fetcher global
import type { Testimonial } from '@/types'; // ✅ Importamos el tipo correcto

import { getImage } from 'astro:assets';
import heroPoster from '@/assets/images/hero-poster.png';

// 1. Fetch de Configuración Global (Para usar el WhatsApp actualizado en el Hero si es necesario)
const settings = await getGlobalSettings();

// 2. Fetch de Testimonios
const { data: testimonialsData, error } = await supabase
  .from('testimonials')
  .select('*')
  .eq('approved', true)
  .order('featured', { ascending: false })
  .order('created_at', { ascending: false });

if (error) console.error('Error fetching testimonials:', error);

// Casteamos los datos al tipo correcto
const testimonials = (testimonialsData || []) as unknown as Testimonial[];

const optimizedPoster = await getImage({ src: heroPoster, format: 'webp', width: 1920 });
const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://lareservabartending.com/#website",
      "url": "https://lareservabartending.com/",
      "name": "La Reserva",
      "description": "Experiencias de coctelería para bodas, cumpleaños y eventos privados en Lima."
    },
    {
      "@type": "Organization",
      "@id": "https://lareservabartending.com/#organization",
      "name": "La Reserva Bartending",
      "url": "https://lareservabartending.com/",
      "logo": "https://lareservabartending.com/logo.png",
      "sameAs": [
        settings.social_instagram,
        settings.social_facebook,
        settings.social_tiktok
      ].filter(Boolean)
    }
  ]
};
---

<PageLayout 
  title="La Reserva | Bartender y Coctelería para Eventos en Lima"
  description="Experiencias de coctelería para bodas, cumpleaños y eventos privados en Lima. Diseñamos la barra, carta y servicio según tu celebración."
  schema={homeSchema}
>
  
  {/* 1. Hero Section */}
  {/* Pasamos la url de whatsapp como prop por si el Hero tiene botón de acción */}
  <Hero
    client:load
    title="Coctelería Premium"
    subtitle="Diseñamos la experiencia de bar de tu evento: bartenders profesionales, carta personalizada, barra, cristalería e insumos."
    videoDesktop="/videos/hero-desktop.mp4" 
    videoMobile="/videos/hero-mobile.mp4"
    poster={optimizedPoster.src} 
    whatsappUrl={settings.whatsapp_url} 
  />

  {/* 2. Servicios Section */}
  {/* Nota: Este componente (Services.astro) deberá ser editado individualmente luego para leer de la BD */}
  <Services />
  
  {/* 3. Testimonials Section */}
  <section class="relative py-24 md:py-32 bg-secondary-50 overflow-hidden border-t border-secondary-200/60">
    <div class="container-custom">
      <div class="text-center mb-16 max-w-3xl mx-auto">
        <span class="text-primary-600 font-bold tracking-widest uppercase text-sm mb-3 block">
          Testimonios
        </span>
        <h2 class="text-3xl md:text-5xl font-display font-bold text-secondary-900 mb-6 leading-tight">
          Cada evento deja una historia.
        </h2>
        <div class="w-20 h-1 bg-primary-500 mx-auto rounded-full mb-8"></div>
        <p class="text-lg md:text-xl text-secondary-600 leading-relaxed font-body">
          Estas son algunas de las experiencias que hemos tenido el privilegio de crear.
        </p>
      </div>
  
      {/* Renderizado condicional */}
      {testimonials && testimonials.length > 0 ? (
        <TestimonialsSlider client:visible testimonials={testimonials} />
      ) : (
        <div class="text-center p-8 bg-white rounded-lg shadow-sm border border-secondary-100">
          <p class="text-secondary-400">No hay testimonios destacados disponibles por el momento.</p>
        </div>
      )}
    </div>
  </section>

</PageLayout>