---
// src/layouts/BaseLayout.astro
import '@/styles/global.css';
// ✅ 1. Importamos el Router de Cliente (antes ViewTransitions)
import { ClientRouter } from 'astro:transitions';
import { getGlobalSettings } from '@/lib/data';
import CookieConsent from '@/components/privacy/CookieConsent.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, any>;
}

const {
  title,
  description = 'Servicio de bartender exclusivo para eventos premium en Lima, Perú. Cócteles de autor y servicio excepcional.',
  image = '/images/og-image.jpg',
  noindex = false,
  schema,
} = Astro.props;

const settings = await getGlobalSettings();

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://lareservabartending.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#D4AF37" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="La Reserva" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl)} />
    
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, siteUrl)} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;900&family=Montserrat:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    
    {/* ✅ 2. Activamos las transiciones suaves SPA en todo el sitio */}
    <ClientRouter />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "La Reserva",
      "description": "Experiencias de coctelería para bodas, cumpleaños y eventos privados en Lima.",
      "url": "https://lareservabartending.com",
      "telephone": settings.contact_phone,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lima",
        "addressCountry": "PE",
        "streetAddress": settings.address
      },
      "areaServed": {
        "@type": "AdministrativeArea",
        "name": "Lima Metropolitana"
      }
    })} />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
    {/* ✅ 3. Preparación de Google Consent Mode v2 (Privacidad por defecto, sin rastreadores) */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'analytics_storage': 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });

      try {
        var storedConsent = localStorage.getItem('lr_cookie_consent_v1');
        if (storedConsent) {
          var parsed = JSON.parse(storedConsent);
          if (parsed && parsed.categories) {
            gtag('consent', 'update', {
              'analytics_storage': parsed.categories.analytics ? 'granted' : 'denied',
              'ad_storage': parsed.categories.marketing ? 'granted' : 'denied',
              'ad_user_data': parsed.categories.marketing ? 'granted' : 'denied',
              'ad_personalization': parsed.categories.marketing ? 'granted' : 'denied'
            });
          }
        }
      } catch (e) {
        // LocalStorage no disponible
      }
    </script>
  </head>
  <body class="antialiased">
    <slot />
    <CookieConsent />
  </body>
</html>
