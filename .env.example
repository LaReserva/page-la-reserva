# ============================================
# LA RESERVA - EJEMPLO DE VARIABLES DE ENTORNO
# Copia este archivo a .env y completa los valores
# ============================================

# Supabase
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima
SUPABASE_SERVICE_KEY=tu-clave-de-servicio

# Site
PUBLIC_SITE_URL=http://localhost:3000

# Resend (Emails)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Web Push (VAPID)
PUBLIC_VAPID_KEY=tu-clave-publica-vapid
PRIVATE_VAPID_KEY=tu-clave-privada-vapid
VAPID_SUBJECT=mailto:tu-correo@dominio.com
